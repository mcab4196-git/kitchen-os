# ─────────────────────────────────────────────────────────────
# Kitchen OS — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# --- Supabase project (Project Settings → API) ---
# Safe to expose to the browser (used by the PWA client with RLS enforced):
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Postgres connection strings (Project Settings → Database) ---
# DATABASE_URL  -> pooled connection (PgBouncer, port 6543) used by the app at runtime.
#                  Must include ?pgbouncer=true so Prisma disables prepared statements.
# DIRECT_URL    -> direct connection (port 5432) used only for migrations / RLS / seed.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- App ---
# Used to build auth redirect URLs. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI provider keys are NOT needed until Milestone M2 (receipt scanning).
# They will be added here then, server-side only (never NEXT_PUBLIC_).

# ── M2: Receipt scanning (AI + storage) ──
# Server-side only. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
# Pin an exact model ID (verify current IDs in your Anthropic console).
ANTHROPIC_MODEL="claude-sonnet-5"
# Provider selector (default: anthropic)
AI_PROVIDER="anthropic"
# Supabase Storage bucket for receipt images (create it per prisma/storage.sql)
RECEIPTS_BUCKET="receipts"
